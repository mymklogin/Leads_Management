{
    "outputDirectory":  "frontend/dist",
    "buildCommand":  "cd frontend \u0026\u0026 npm install \u0026\u0026 npm run build",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "framework":  "vite"
}
